{
  "manifest_version": 2,
  "plugin_type": "chat",
  "id": "ilworkcn.maiweave",
  "name": "MaiWeave · 麦织｜与你共织日常",
  "version": "0.9.0",
  "description": "把对话织进持续的生活：约定影响日程，天气与真实地点参与安排，读过的书留下进度和感想。关联 MaiBot 人物画像，让昨天的经历接上今天的聊天。",
  "author": {
    "name": "ilworkcn",
    "url": "https://github.com/ilworkcn"
  },
  "license": "GPL-3.0-only",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "lunar_python",
      "version_spec": "==1.4.8"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2026.1"
    }
  ],
  "capabilities": [
    "llm.generate",
    "database.get",
    "config.get",
    "send.text",
    "maisaka.proactive.trigger",
    "web.search",
    "web.fetch",
    "chat.open_session",
    "person.get_value",
    "chat.get_all_streams",
    "person.get_id",
    "llm.get_available_models",
    "maisaka.reply.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "urls": {
    "repository": "https://github.com/ilworkcn/MaiWeave"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  }
}
