{
  "manifest_version": 2,
  "plugin_type": "chat",
  "id": "ilworkcn.maiweave",
  "name": "MaiWeave · 麦织｜角色生活引擎",
  "version": "0.11.8",
  "description": "让麦麦有自己的生活，你的对话也能影响它的生活；随着相处积累熟悉、信任与亲近，记住你的近况、生日和彼此的约定，主动问候、关心后续；读你上传的书，记下进度、感想与疑问，下次继续读，也能和你聊聊书里的故事；参考真实天气和城市地点安排活动，上网寻找新见闻，把一天的经历写进日记，整理成随笔发到 QQ 空间。",
  "author": {
    "name": "ilworkcn",
    "url": "https://github.com/ilworkcn"
  },
  "license": "GPL-3.0-only",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "lunar_python",
      "version_spec": "==1.4.8"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2026.1"
    }
  ],
  "capabilities": [
    "llm.generate",
    "database.get",
    "config.get",
    "send.text",
    "maisaka.proactive.trigger",
    "web.search",
    "web.fetch",
    "chat.open_session",
    "person.get_value",
    "chat.get_all_streams",
    "person.get_id",
    "llm.get_available_models",
    "maisaka.reply.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "urls": {
    "repository": "https://github.com/ilworkcn/MaiWeave"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  }
}
