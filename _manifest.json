{
  "manifest_version": 2,
  "plugin_type": "chat",
  "id": "ilworkcn.maiweave",
  "name": "MaiWeave · 麦织｜角色生活引擎",
  "version": "0.10.0",
  "description": "让麦麦有自己的生活，也让你参与其中：自主安排作息、读书、出门，一句邀约就能改变日程。私聊道过晚安，群里再见也记得；读你上传的书，接着上次的感想与疑问继续读。结合真实天气和城市地点安排活动，按兴趣上网寻找新见闻，带着经历来聊天、道早晚安，还能把当天日记整理成随笔发到 QQ 空间。",
  "author": {
    "name": "ilworkcn",
    "url": "https://github.com/ilworkcn"
  },
  "license": "GPL-3.0-only",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "lunar_python",
      "version_spec": "==1.4.8"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2026.1"
    }
  ],
  "capabilities": [
    "llm.generate",
    "database.get",
    "config.get",
    "send.text",
    "maisaka.proactive.trigger",
    "web.search",
    "web.fetch",
    "chat.open_session",
    "person.get_value",
    "chat.get_all_streams",
    "person.get_id",
    "llm.get_available_models",
    "maisaka.reply.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "urls": {
    "repository": "https://github.com/ilworkcn/MaiWeave"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  }
}
