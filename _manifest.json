{
  "manifest_version": 2,
  "plugin_type": "chat",
  "id": "ilworkcn.maiweave",
  "name": "MaiWeave · 麦织｜阅读与生活",
  "version": "0.8.1",
  "description": "给麦麦一本书，让它按日程阅读、留下笔记，和你聊读后感。聊天也能改变生活安排，串起日记、人物关系与纪念日。",
  "author": {
    "name": "ilworkcn",
    "url": "https://github.com/ilworkcn"
  },
  "license": "GPL-3.0-only",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "lunar_python",
      "version_spec": "==1.4.8"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2026.1"
    }
  ],
  "capabilities": [
    "llm.generate",
    "config.get",
    "send.text",
    "maisaka.proactive.trigger",
    "web.search",
    "web.fetch",
    "chat.open_session",
    "person.get_value",
    "chat.get_all_streams",
    "person.get_id",
    "llm.get_available_models"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "urls": {
    "repository": "https://github.com/ilworkcn/MaiWeave"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  }
}
